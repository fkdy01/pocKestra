# Configuration du poste client. Ne jamais y commiter les valeurs réelles.
KESTRA_URL=https://kestra-vip.example.invalid
KESTRA_TENANT=main
KESTRA_RUN_TESTS=false
KESTRA_USERNAME=
KESTRA_PASSWORD=
KESTRA_API_TOKEN=
KESTRA_VERIFY_TLS=true
# Laisser vide si l'autorité est déjà approuvée par le système.
KESTRA_CA_BUNDLE=
# URL joignable depuis les workers Kestra, et non depuis le seul poste client.
KESTRA_MOCK_BASE_URL=https://mock-kestra.example.invalid
KESTRA_HTTP_TIMEOUT=60
