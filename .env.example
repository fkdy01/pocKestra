# Configuration locale pour les tests automatisés Kestra pilotés par Codex / VS Code.

# Mot de passe PostgreSQL local utilisé par Docker Compose.
# Remplacer cette valeur dans `.env` uniquement. Ne jamais y placer un secret réel
# de production.
KESTRA_DB_PASSWORD=SECRET_NON_CONFIGURE

# Image Kestra OSS. Conserver une version épinglée pour un POC reproductible.
KESTRA_IMAGE=kestra/kestra:v1.3.20

# URL de l'instance Kestra OSS/Enterprise à tester.
KESTRA_URL=http://localhost:8080

# Tenant Kestra. En OSS récent, le tenant par défaut est généralement `main`.
KESTRA_TENANT=main

# Les tests live sont désactivés par défaut pour éviter les échecs hors environnement.
# Activer avec :
#   python3 scripts/run_kestra_tests.py --kestra-live
# ou avec pytest :
#   pytest tests/kestra --kestra-live
KESTRA_RUN_TESTS=false

# Authentification optionnelle.
# Laisser vide pour une instance OSS locale sans auth.
KESTRA_USERNAME=
KESTRA_PASSWORD=
KESTRA_API_TOKEN=

# TLS.
KESTRA_VERIFY_TLS=true
KESTRA_HTTP_TIMEOUT=30
